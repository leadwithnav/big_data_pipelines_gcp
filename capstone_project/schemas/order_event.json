{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderEvent",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "price": {
      "type": "number",
      "minimum": 0.01
    },
    "customer_id": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "RETURNED", "CANCELLED"]
    }
  },
  "required": ["order_id", "store_id", "product_id", "quantity", "price", "event_time"]
}
